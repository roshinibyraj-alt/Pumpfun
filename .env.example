# All optional. Defaults shown.

# Paper trading only for now.
# TRADING_MODE=paper
# STARTING_CAPITAL=2000

# Entry: one taker market buy, fired this many seconds after the window opens.
# ENTRY_DELAY_SECONDS=2
# TAKER_SHARES=300

# Binance klines endpoint for the previous window's 1-minute closes (the signal)
# and the dashboard's live min1-min5 prices (no API key).
# Override if your host is geo-blocked, e.g. https://api.binance.us/api/v3/klines
# BINANCE_KLINES_URL=https://api.binance.com/api/v3/klines
# BINANCE_SYMBOL=BTCUSDT
# LIVE_MINUTES_POLL_SECONDS=1.0

# POLL_INTERVAL_SECONDS=1.0
