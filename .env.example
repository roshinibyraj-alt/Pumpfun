# Live mode is intentional. Set TRADING_MODE=paper only for local simulation.
TRADING_MODE=live
POLYMARKET_PRIVATE_KEY=set-this-in-Replit-or-Railway-secrets

# Exact dollar sizing ladder after consecutive wins.
ORDER_LADDER_USD=5,4,3,2,1,0

# Live entry triggers. Comparisons are strict: price < threshold.
LIVE_FIRST_PHASE_SECONDS=30
LIVE_FIRST_PHASE_TRIGGER=0.40
LIVE_SECOND_PHASE_TRIGGER=0.50

# The bridge uses the highest valid tick below 1.00 as the FOK max BUY price.
LIVE_MAX_PRICE=0.99

# Final-second CLOB winner confirmation.
WINNER_THRESHOLD=0.95
FINAL_SECOND_SECONDS=1.0

# Polling and logs.
POLL_INTERVAL_SECONDS=1.0
LOG_FILE_PATH=logs/bot-events.jsonl
LOG_FILE_MAX_BYTES=10485760
