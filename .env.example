# The app is paper trading by default.
TRADING_MODE=paper
STARTING_CAPITAL=2000

# BTC 5-minute binary sizing progression.
BASE_SHARES=500
WIN_STEP_SHARES=100

# Entry rules.
LIMIT_ENTRY_PRICE=0.40
LIMIT_TIMEOUT_SECONDS=30
TAKER_MAX_PRICE=0.60

# Final-second CLOB winner confirmation.
WINNER_THRESHOLD=0.95
FINAL_SECOND_SECONDS=1.0

# Polling and optional fee simulation.
POLL_INTERVAL_SECONDS=1.0
APPLY_TAKER_FEES=true