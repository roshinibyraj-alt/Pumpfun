# Copy to .env for local runs. On Railway, set these as Variables instead.

# --- Window ---
WINDOW_SECONDS=300
WINDOW_LABEL=5m
ASSET=btc

# --- Capital / sizing ---
STARTING_CAPITAL_PER_ENGINE=500
SHARES_PER_TRADE=100

# --- Take-profit (universal, all 9 engines) ---
# Hitting this trigger pays a clean $1.00/share with NO fee -- treated
# like a winning resolution, not an actual market sale at 0.99.
TAKE_PROFIT_TRIGGER_PRICE=0.99
TAKE_PROFIT_PAYOUT_PRICE=1.00

# --- Fees (fallback only; live rate is read per-market from Gamma) ---
FALLBACK_TAKER_FEE_RATE=0.07

# --- Resolution (hold-to-close path, for positions never sold via TP/SL) ---
GAMMA_RESOLUTION_CONFIDENCE=0.99
GAMMA_RESOLUTION_TIMEOUT_SECONDS=90
CLOB_FALLBACK_PRICE_THRESHOLD=0.97

# --- Polling ---
POLL_INTERVAL_SECONDS=1.0
RESOLUTION_POLL_SECONDS=1.5
RESOLUTION_POLL_TIMEOUT_SECONDS=180

# --- Storage ---
# If you attach a Railway Volume, mount it at /data and this is picked up
# automatically. Otherwise it falls back to a local file (lost on redeploy).
DB_PATH=/data/nine_engine_bot_state.db

# --- Web ---
PORT=8080

# Engine definitions (E1-E9: entry/trigger prices, SL levels, skip
# lengths) are NOT env-configurable by design -- they're the core spec
# of this bot and live in app/config.py's ENGINES list.
