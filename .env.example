# The app is paper trading by default.
TRADING_MODE=paper
STARTING_CAPITAL=5000

# Fixed dollar notional per eligible signal; shares are derived at execution.
ORDER_USD=500

# Entry rules: maker for 30s, then taker only below $0.60.
LIMIT_ENTRY_PRICE=0.40
LIMIT_ORDER_TIMEOUT_SECONDS=30
TAKER_ENTRY_MAX_PRICE=0.60

# Final-second CLOB winner confirmation.
WINNER_THRESHOLD=0.95
FINAL_SECOND_SECONDS=1.0

# Polling.
POLL_INTERVAL_SECONDS=1.0

# Current Polymarket Crypto fee-equivalent and maker-rebate schedule.
TAKER_FEE_RATE=0.07
MAKER_REBATE_RATE=0.20

# Structured event log written for Railway and later analysis.
LOG_FILE_PATH=logs/bot-events.jsonl
LOG_FILE_MAX_BYTES=10485760
