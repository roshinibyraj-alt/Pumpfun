# Copy to .env for local runs. On Railway, set these as Variables instead.

# --- Bankroll / sizing ---
STARTING_CAPITAL_USD=2000

# Base size every window, unless the decorrelation boost is active (see
# below). A "decorrelation" is a resolved position where BOTH legs lost
# (the actual outcome was the exact opposite combo of the pair bought) --
# that arms BOOSTED_SHARES_PER_LEG for the next window whose entries
# haven't fired yet. The window after that always reverts to base.
BASE_SHARES_PER_LEG=10
BOOSTED_SHARES_PER_LEG=300

# --- Strategy thresholds ---
ENTRY_COMBINED_PRICE=0.85
EXIT_COMBINED_PRICE=1.15

# TP assignment is dynamic, not configured here: whichever pair fires
# first in a window gets the intra-window take-profit (and is locked, no
# re-entry, once it hits); whichever pair fires second gets no
# take-profit and is simply held to resolution.

# --- Execution (taker-only, always crosses the spread) ---
BUY_SLIPPAGE_CEILING=0.99
SELL_SLIPPAGE_FLOOR=0.01
POST_FILL_CHECK_TICKS=2

# --- Fees (fallback only; live rate is read per-market from Gamma) ---
FALLBACK_TAKER_FEE_RATE=0.07

# --- Resolution ---
# Determined PURELY from live CLOB prices -- no Gamma outcomePrices/closed
# check, no fallback path. A leg is a confirmed winner at price >=
# RESOLUTION_PRICE_THRESHOLD ($1/share) or a confirmed loser at price
# <= 1 - RESOLUTION_PRICE_THRESHOLD ($0/share). Ambiguous prices keep polling.
RESOLUTION_PRICE_THRESHOLD=0.90

# --- Polling ---
POLL_INTERVAL_SECONDS=1.5
RESOLUTION_POLL_SECONDS=2
RESOLUTION_POLL_TIMEOUT_SECONDS=180

# --- Storage ---
# If you attach a Railway Volume, mount it at /data and this is picked up
# automatically. Otherwise it falls back to a local file (lost on redeploy).
DB_PATH=/data/bot_state.db

# --- Web ---
PORT=8080
